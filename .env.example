# apps/web
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only — never expose to clients
SESSION_SIGNING_SECRET=             # server only — HMAC key for pairing codes and guest credentials; never commit a real value; never put in NEXT_PUBLIC_*
NEXT_PUBLIC_ENABLE_LIVE_LISTEN=true
NEXT_PUBLIC_DEFAULT_QUALITY=high

# Session backend: production uses Supabase and fails closed without the secrets above.
# Memory is for local development and tests only, and must be opted into:
# PRISM_SESSION_BACKEND=memory
# PRISM_ALLOW_MEMORY_SESSIONS=true

# optional session tuning (server)
# PAIRING_CODE_TTL_MS=600000
# GUEST_CREDENTIAL_TTL_MS=7200000

# optional later AI (server only; unused in MVP mock)
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=

# tooling
POSTGRES_URL=                       # local supabase / CI if needed
